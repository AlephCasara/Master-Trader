# Fleet image for the Zeabur deployment (bd dp1.5): the pinned freqtrade
# digest the local stack runs, with configs/strategies baked in so no bind
# mounts exist on Zeabur (per-service volumes only). One image serves all six
# bots; each service picks its entrypoint script via source.command.
#
# Build from ft_userdata/ (the parent of this directory):
#   docker build -f zeabur/Dockerfile.fleet -t mt-freqtrade:20261001 .
FROM freqtradeorg/freqtrade@sha256:50720a4af314a812be2cfbf5cc6331c63e9332b06f3f4372241f54bc61a35486

# Baked at /opt/mt (NOT /freqtrade/user_data — the Zeabur volume mounts there
# and would shadow them). api_server credentials are blanked at build time:
# live values arrive via FREQTRADE__ env at runtime, and this image is public.
COPY user_data/configs /opt/mt/configs
COPY user_data/strategies /opt/mt/strategies
COPY zeabur/strip-api-creds.py /tmp/strip-api-creds.py
# The base image switches to ftuser; rewriting the root-owned COPY needs root.
USER root
RUN python3 /tmp/strip-api-creds.py && rm /tmp/strip-api-creds.py
USER ftuser
# Docker derives HOME from the passwd entry at runtime; Kubernetes does not.
# Without this, python can't see /home/ftuser/.local user-site packages and
# the freqtrade console script dies with ModuleNotFoundError.
ENV HOME=/home/ftuser

# Resolves USER_DATA = script_dir/user_data -> /freqtrade/user_data (the
# fade bot's volume), reproducing the local funding-refresh paths exactly.
COPY download_funding_rates.py /freqtrade/download_funding_rates.py
COPY --chmod=755 zeabur/mt-run-*.sh /usr/local/bin/
