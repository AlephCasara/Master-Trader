#!/usr/bin/env python3
"""Container variant of the local-LLM classifier subprocess (bd dp1.5).

Mimics the slice of the Claude CLI contract killers_bot/classifier.py relies
on: `-p PROMPT [--output-format json --print] [--model NAME]`. The prompt is
POSTed to an OpenAI-shaped endpoint and the model's answer is printed on
stdout as bare text (classifier.py regex-extracts the JSON object).

Unlike the host wrapper (which targets localhost llama-swap), the endpoint
comes from the environment so the same image works anywhere:

  MT_CLASSIFY_ENDPOINT      full chat-completions URL
  MT_CLASSIFY_BEARER        Authorization bearer (optional)
  MT_CLASSIFY_TIMEOUT_SEC   transport timeout          (default 180)
  MT_CLASSIFY_DEFAULT_MODEL fallback when --model is absent (default qwen3-4b)

On Zeabur the endpoint is the home tailnet funnel in front of llama-swap
(bd dp1.5); locally it can point straight at 127.0.0.1:8080. Keeps the
verified behaviors from the 2026-10-01 baseline: response_format json_object
(decode-time JSON validity), Qwen-family sampling map (greedy decode loops
in qwen thinking), the reasoning_content fallback (thinking models that
deliver nothing in content), and the close_full addendum.
"""
import json
import os
import sys
import urllib.error
import urllib.request

MAX_TOKENS = 4096

# Qwen3-family thinking models MUST NOT be decoded greedily: at temperature 0
# the reasoning degenerates into an endless "Wait, ..." verification loop
# until the token cap, leaving content empty (observed 2026-10-01). Qwen's
# recommended thinking-mode sampling terminates cleanly.
QWEN_FAMILY_PREFIXES = ("qwen", "claudecode-polar")


def sampling_for(model: str) -> dict:
    if model.startswith(QWEN_FAMILY_PREFIXES):
        return {"temperature": 0.6, "top_p": 0.95, "top_k": 20}
    return {"temperature": 0}


# Local-models-only prompt addendum (baseline 2026-10-01: gpt-oss-20b and
# qwen3-4b read final target-update posts as close_partial; haiku reads them
# correctly). Repo prompts stay untouched — this compensates the local models
# inside the wrapper.
ADDENDUM = (
    "\n\nADDENDUM: If the message is a target-update post where EVERY listed "
    "target is marked hit (e.g. ✅) or it says all targets were reached/"
    "smashed, kind MUST be \"close_full\" — the position is fully exited. "
    "\"close_partial\" is only for SOME targets hit or an explicit partial "
    "close percentage."
)


def extract_last_kind_json(text: str):
    """Last well-formed JSON object in `text` carrying a "kind" key —
    reasoning drafts iterate toward the final answer, so the last complete
    one is the verdict."""
    decoder = json.JSONDecoder()
    best = None
    idx = text.find("{")
    while idx != -1:
        try:
            obj, _end = decoder.raw_decode(text, idx)
            if isinstance(obj, dict) and "kind" in obj:
                best = obj
        except json.JSONDecodeError:
            pass
        idx = text.find("{", idx + 1)
    return best


def main() -> None:
    endpoint = os.environ.get("MT_CLASSIFY_ENDPOINT", "")
    bearer = os.environ.get("MT_CLASSIFY_BEARER", "")
    timeout = float(os.environ.get("MT_CLASSIFY_TIMEOUT_SEC", "180"))
    default_model = os.environ.get("MT_CLASSIFY_DEFAULT_MODEL", "qwen3-4b")
    if not endpoint:
        print("mt-classify: MT_CLASSIFY_ENDPOINT is not set", file=sys.stderr)
        sys.exit(2)

    args = sys.argv[1:]
    prompt = None
    model = None
    i = 0
    while i < len(args):
        if args[i] == "-p" and i + 1 < len(args):
            prompt = args[i + 1]
            i += 2
            continue
        if args[i] == "--model" and i + 1 < len(args):
            model = args[i + 1]
            i += 2
            continue
        i += 1  # --output-format json --print etc: claude-shaped, ignored

    if prompt is None:
        print("mt-classify: missing -p prompt", file=sys.stderr)
        sys.exit(2)

    model = model or default_model
    body = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": prompt + ADDENDUM}],
        **sampling_for(model),
        "max_tokens": MAX_TOKENS,
        "stream": False,
        # llama-server enforces a JSON grammar at decode time: the model
        # physically cannot emit malformed JSON, which a small model
        # occasionally does otherwise.
        "response_format": {"type": "json_object"},
    }).encode()
    headers = {"Content-Type": "application/json"}
    if bearer:
        headers["Authorization"] = f"Bearer {bearer}"
    req = urllib.request.Request(endpoint, data=body, headers=headers)

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = json.load(resp)
    except urllib.error.HTTPError as exc:
        detail = exc.read()[:300]
        print(f"mt-classify: HTTP {exc.code}: {detail!r}", file=sys.stderr)
        sys.exit(1)
    except Exception as exc:  # noqa: BLE001 - one boundary, reported + exit 1
        print(f"mt-classify: {exc}", file=sys.stderr)
        sys.exit(1)

    try:
        message = payload["choices"][0]["message"]
    except (KeyError, IndexError):
        print(f"mt-classify: unexpected payload {str(payload)[:300]}",
              file=sys.stderr)
        sys.exit(1)

    content = (message.get("content") or "").strip()
    if not content:
        # Thinking models (qwen3.5 family) sometimes deliver everything in
        # reasoning_content and an empty content. Capture instead of fail.
        reasoning = (message.get("reasoning_content") or "").strip()
        if reasoning:
            best = extract_last_kind_json(reasoning)
            if best is not None:
                content = json.dumps(best)
                print("mt-classify: empty content; captured JSON "
                      "from reasoning_content", file=sys.stderr)
            else:
                content = reasoning
                print("mt-classify: empty content, no kind-JSON in "
                      "reasoning; passing reasoning through", file=sys.stderr)

    text = content.strip()
    if text.startswith("```"):
        first_newline = text.find("\n")
        if first_newline != -1:
            text = text[first_newline + 1:]
        text = text.removesuffix("```").strip()

    sys.stdout.write(text + "\n")


if __name__ == "__main__":
    main()
